# 当前先填 SimNow 页面显示的参数；不要把真实 .env 提交到 Git。
CTP_USER_ID=填入SimNow投资者账号
CTP_PASSWORD=填入SimNow密码
CTP_BROKER_ID=填入SimNow经纪商代码
# 第一套环境前置；--env first（默认）使用这两项。
CTP_TRADE_FRONT=填入SimNow交易前置
CTP_MARKET_FRONT=填入SimNow行情前置
# 7×24 API 测试环境前置；--env 7x24 使用这两项。
CTP_7X24_TRADE_FRONT=tcp://182.254.243.31:40001
CTP_7X24_MARKET_FRONT=tcp://182.254.243.31:40011
CTP_APP_ID=填入SimNow产品名称或AppID
CTP_AUTH_CODE=填入SimNow授权编码
CTP_PRODUCT_INFO=

# 广发期货仿真看穿式环境；--env guangfa 使用独立账号和前置，不复用 SimNow 凭证。
CTP_GUANGFA_USER_ID=填入广发仿真投资者账号
CTP_GUANGFA_PASSWORD=填入广发仿真密码
CTP_GUANGFA_BROKER_ID=2358
CTP_GUANGFA_TRADE_FRONT=tcp://183.62.252.251:42405
CTP_GUANGFA_MARKET_FRONT=tcp://183.62.252.251:42413
CTP_GUANGFA_APP_ID=填入广发提供的AppID
CTP_GUANGFA_AUTH_CODE=填入广发提供的授权码
CTP_GUANGFA_PRODUCT_INFO=

# 留空时只连接并打印账户/持仓；填入当前有效合约后自动订阅该合约行情。
CTP_SYMBOL=
CTP_EXCHANGE=SHFE
